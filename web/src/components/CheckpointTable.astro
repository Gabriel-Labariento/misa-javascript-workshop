---
import mapping from '../data/checkpoints.json';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<table>
  <thead><tr><th>Checkpoint</th><th>Lesson</th><th>What runs</th><th>Try it</th></tr></thead>
  <tbody>
    {mapping.map((item) => (
      <tr>
        <td><a href={`${site.repo}/tree/${item.id}/workshop`}>{item.id}</a></td>
        <td><a href={`${base}/${item.lesson}/`}>{item.lesson}</a></td>
        <td>{item.expected}</td>
        <td><a href={`${base}/playground/?checkpoint=${item.id}`}>Playground</a></td>
      </tr>
    ))}
  </tbody>
</table>
