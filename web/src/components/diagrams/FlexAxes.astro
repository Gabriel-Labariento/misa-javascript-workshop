---
// A flex row with its two directions marked, and the property for each.
import Figure from './Figure.astro';
const { caption } = Astro.props;
---

<Figure caption={caption} label="In a flex row, justify-content works along the main axis and align-items across it">
  <div class="wrap">
    <div class="cross" aria-hidden="true"><span>cross axis<br /><code>align-items</code></span></div>
    <div>
      <div class="box">
        <div class="item">1</div>
        <div class="item">2</div>
        <div class="item">3</div>
      </div>
      <div class="main-axis" aria-hidden="true"><span>main axis · <code>justify-content</code></span></div>
    </div>
  </div>
</Figure>

<style>
  .wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
  }
  .box {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    height: 9rem;
    padding: 0.75rem;
    border: 2px dashed var(--sl-color-gray-3);
    border-radius: 0.5rem;
  }
  .item {
    padding: 1rem 1.4rem;
    border-radius: 0.4rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 700;
  }
  code {
    background: none;
    border: 0;
    padding: 0;
    color: var(--sl-color-accent-high);
  }
  .main-axis,
  .cross {
    position: relative;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .main-axis {
    margin-top: 0.6rem;
    padding-top: 0.7rem;
    border-top: 2px solid var(--sl-color-gray-3);
    text-align: center;
  }
  .main-axis::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -6px;
    border: 5px solid transparent;
    border-left: 8px solid var(--sl-color-gray-3);
    border-right: 0;
  }
  .cross {
    display: flex;
    align-items: center;
    height: 9rem;
    padding-right: 0.7rem;
    border-right: 2px solid var(--sl-color-gray-3);
    text-align: right;
  }
  .cross::after {
    content: '';
    position: absolute;
    right: -6px;
    bottom: -1px;
    border: 5px solid transparent;
    border-top: 8px solid var(--sl-color-gray-3);
    border-bottom: 0;
  }
</style>
